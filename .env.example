# Copy to .env and fill in. Never commit .env.
# ---------- web ----------
# Public URL. http://localhost:8000 for local dev; https://your.domain behind the "web" proxy.
BASE_URL=http://localhost:8000
# docker-compose "web" (Caddy) site address: ":80" for plain HTTP, or "your.domain" for automatic HTTPS.
SITE_ADDRESS=:80
# Gmail addresses that may sign in (comma-separated). Sign-in is Google-only; empty = nobody can sign in.
# Your data belongs to the Gmail you sign in with, so signing in on another device shows the same history.
ALLOWED_EMAILS=you@gmail.com

# ---------- Google ----------
# OAuth client: download the "Web application" client JSON from Cloud Console and save it as
# YTStudioCred.json next to main.py (and next to docker-compose.yml). Redirect URI to register:
# ${BASE_URL}/oauth2callback
# GOOGLE_CLIENT_SECRETS_FILE=./YTStudioCred.json

# ---------- secrets ----------
# Fernet key for OAuth tokens at rest. Generate:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Rotation: put the NEW key first, keep the old one after a comma, run `python -m ytstudio.cli rotate-keys`,
# then remove the old key.
TOKEN_ENCRYPTION_KEY=

# ---------- database / redis (local dev defaults; docker-compose overrides these) ----------
# DATABASE_URL=sqlite:///ytstudio.db
# DATABASE_URL=postgresql+psycopg://ytstudio:password@localhost:5432/ytstudio
# Redis DBs: 0 = Celery broker, 1 = Celery results, 2 = app (prefixes yt:cache, yt:lock, yt:rl, yt:quota, yt:llm, yt:beat)
# REDIS_URL=redis://localhost:6379/2
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ---------- storage ----------
# Masters, rendered Shorts and covers are stored on local disk here.
# MEDIA_DIR=./media
# Largest master file accepted, bytes (default 20 GB)
# MAX_MASTER_BYTES=21474836480

# ---------- LLM ----------
# Nothing about AI is set here. API keys (Gemini, Mistral, OpenAI, Anthropic) and the models are chosen in the app,
# on the LLM page (sidebar, under Sign out), and the keys are saved encrypted in the database. The default
# models are in config/llm.toml.
# Daily LLM budget is per user in Settings (0 = no limit, the default; right for free API keys).

# ---------- YouTube quota ----------
QUOTA_DAILY_LIMIT=10000
# Non-critical calls (trend searches, other channels' stats) stop at this share of the day's quota
QUOTA_NONCRITICAL_PCT=80
# Topic searches cost 100 units each; this caps them per channel per Pacific day
SEARCHES_PER_CHANNEL_PER_DAY=4
OUTLIER_MIN_MULTIPLE=2.0

# ---------- monitoring ----------
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-three
# Warn (log + /health) when Celery Beat has not ticked for this many minutes
BEAT_STALE_MINUTES=15

# ---------- media ----------
# faster-whisper model for the fallback transcriber (tiny, base, small, medium, large-v3)
WHISPER_MODEL=small

# ---------- feature flags ----------
# Existing Publish page (manual upload/live, only when you press the button)
ENABLE_MANUAL_PUBLISH=true
# yt-dlp for your own videos: off. Check YouTube's Terms of Service before turning on. (Not implemented yet.)
ENABLE_YTDLP=false
# Automatic publishing: stays off; there is no implementation behind it.
ENABLE_AUTO_PUBLISH=false

# ---------- logging ----------
LOG_LEVEL=INFO
LOG_JSON=true
